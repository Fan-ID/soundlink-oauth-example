# Soundlink
SOUNDLINK_BASE_URL=https://getsoundlink.com
SOUNDLINK_API_BASE_URL=https://api.getsoundlink.com
SOUNDLINK_CLIENT_ID=
SOUNDLINK_CLIENT_SECRET=
SOUNDLINK_REDIRECT_URI=http://localhost:3005/api/oauth/callback
SOUNDLINK_SCOPES=openid email campaigns:read metrics:read

# App
PORT=3005
APP_BASE_URL=http://localhost:3005
# Required outside local development. The app falls back to a known dev default if unset —
# never deploy with that fallback.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: comma-separated hostnames for HTTPS tunnels (ngrok, Cloudflare Tunnel).
# Example: ALLOWED_DEV_ORIGINS=your-subdomain.ngrok-free.app
# ALLOWED_DEV_ORIGINS=
